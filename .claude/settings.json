{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(psql:*)",
      "Bash(docker compose:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(date:*)",
      "Bash(printenv CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS)",
      "Bash(VITEST_MAX_WORKERS=4 make test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout --no-track -b:*)",
      "Bash(git checkout TYRE-:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a --list:*)",
      "Bash(git branch -f pipeline-review-base:*)",
      "Bash(git branch --set-upstream-to=:*)",
      "Bash(git branch -D pipeline-review-base)",
      "Bash(git worktree list)",
      "Bash(git worktree add:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh run:*)",
      "Bash(timeout 540 gh run watch:*)",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePage",
      "mcp__claude_ai_Atlassian_Rovo__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian_Rovo__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian_Rovo__getIssueLinkTypes",
      "mcp__claude_ai_Atlassian_Rovo__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__search",
      "mcp__claude_ai_Atlassian_Rovo__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__transitionJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__createJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__createIssueLink"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "Bash(az:*)",
      "Bash(terraform:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-not-piped.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/merge-push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/migration-immutable.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comment-style.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "advisorModel": "fable",
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
