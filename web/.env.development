# Stub identity provider for the Playwright auth project (e2e/auth.spec.ts).
# idp.test is a reserved name that never resolves (RFC 6761). vite dev loads
# these, but nothing reads them unless localStorage "tyre.dev.auth" is
# "bearer" (src/api/token.ts), so every other dev session is unaffected.
VITE_AUTH_AUTHORITY=https://idp.test/
VITE_AUTH_CLIENT_ID=e2e-pwa
VITE_AUTH_API_SCOPE=api://e2e-api/access_as_user
