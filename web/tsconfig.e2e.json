{
  // A second program, not part of the app's: Playwright's types need node
  // globals (Buffer) and ESNext symbols (Symbol.asyncDispose) the DOM-only
  // app project excludes. Same strictness, different platform.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    // DOM and @types/node both declare TextDecoder/TextEncoder and disagree
    // at the .d.ts level; a program needing both (addInitScript callbacks run
    // in the browser, the spec runs in node) cannot referee them. Only
    // library cross-checking is skipped; our files stay strict.
    "skipLibCheck": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
