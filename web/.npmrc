# TYRE-21. Transitive dependencies are the exposure: 59 of 119 locked packages
# were under 14 days old before this ticket, and Renovate does not manage
# transitives at all. This gate is what stops them re-floating onto
# hours-old releases on the next resolution.
#
# Requires npm >= 11.10.0. Older npm silently ignores unknown keys, so on
# npm 10 or below this file enforces nothing at all — CI pins npm for that
# reason.
min-release-age=14

# Renovate keeps the escape hatch for a security fix younger than the window
# (`vulnerabilityAlerts.minimumReleaseAge: null` in renovate.json). There is no
# standing exclusion here: an exclusion and a package.json override that
# disagree make `npm install` die with ETARGET while `npm ci` stays green,
# because ci does not re-resolve — so the pair only ever ships together, and
# only for as long as the fix is younger than the window.
